[Unit]
Description=PurveX (backend + frontend)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/splunk/PurveX
ExecStart=/home/splunk/PurveX/start_purvex
Restart=on-failure
RestartSec=3
Environment=PURVEX_ENV=prod
Environment=USE_GUNICORN=1
Environment=CREATE_DEFAULT_ADMIN=false
Environment=BACKEND_WORKERS=2

[Install]
WantedBy=multi-user.target
