# =============================================================================
# PurveX Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control.
# =============================================================================

# --- Required in ALL environments ---

# JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Encryption key for secrets at rest (SIEM credentials, TOTP secrets, API keys).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PURVEX_ENCRYPTION_KEY=

# --- Deployment environment ---
# Options: dev, staging, prod
PURVEX_ENV=dev

# --- Database ---
# For production, use PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/purvex
# Defaults to SQLite in dev if not set.
# DATABASE_URL=

# --- AI Assistant (optional) ---
# AI_PROVIDER=OpenAI
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Default admin (dev only, ignored in prod) ---
# CREATE_DEFAULT_ADMIN=true
# DEFAULT_ADMIN_EMAIL=admin
# DEFAULT_ADMIN_PASSWORD=admin
