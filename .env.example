# =============================================================================
# PurveX Environment Configuration
# =============================================================================
# You don't need to fill in most of this by hand: ./scripts/purvex.sh --setup
# creates .env from this file and generates JWT_SECRET_KEY and
# PURVEX_ENCRYPTION_KEY for you automatically. DATABASE_URL doesn't need to
# be set either -- leave it unset and PurveX stores everything in a local
# SQLite file, no separate database install required. This file exists for
# manual/advanced setups and as a reference for what each value does.
#
# SECURITY: Never commit .env to version control.
# =============================================================================

# --- Required in ALL environments (auto-generated by --setup if left blank) ---

# JWT signing key.
JWT_SECRET_KEY=

# Encryption key for secrets at rest (SIEM credentials, API keys).
PURVEX_ENCRYPTION_KEY=

# --- Deployment environment ---
# Options: dev, staging, prod
PURVEX_ENV=dev

# --- Database ---
# Leave unset for a single-machine install: PurveX stores everything in a
# local SQLite file (backend/purvex.db) by default. Only set this if you
# want PostgreSQL -- required for staging/prod, and worth it once more than
# a couple of people use the same instance.
# DATABASE_URL=postgresql+asyncpg://purvex:password@localhost:5432/purvex

# --- Redis (required in staging/prod; enables distributed rate limiting) ---
# REDIS_URL=redis://localhost:6379/0

# --- AI Assistant (optional) ---
# AI_PROVIDER=OpenAI
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Application URL ---
# Public URL the app is reachable at. Used to build links in outbound email
# (password reset, invites). Must be set to the real URL in staging/prod.
APP_BASE_URL=http://127.0.0.1:1120

# --- Email / SMTP (optional in dev) ---
# Without this, password reset and user invites still work but no email is
# actually sent — the token/link is only visible in the server log.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@yourcompany.com
# SMTP_FROM_NAME=PurveX
# SMTP_USE_TLS=true

# --- Default admin (dev only, ignored in prod) ---
# CREATE_DEFAULT_ADMIN=true
# DEFAULT_ADMIN_EMAIL=admin
# DEFAULT_ADMIN_PASSWORD=admin
