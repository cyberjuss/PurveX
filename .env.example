# =============================================================================
# PurveX Environment Configuration
# =============================================================================
# You don't need to fill in most of this by hand: ./scripts/purvex.sh --setup
# creates .env from this file, generates JWT_SECRET_KEY and
# PURVEX_ENCRYPTION_KEY, and installs/configures PostgreSQL for you
# automatically (prompting only for a database password). This file exists
# for manual/advanced setups and as a reference for what each value does.
#
# SECURITY: Never commit .env to version control.
# =============================================================================

# --- Required in ALL environments (auto-generated/auto-configured by --setup if left blank) ---

# JWT signing key.
JWT_SECRET_KEY=

# Encryption key for secrets at rest (SIEM credentials, API keys).
PURVEX_ENCRYPTION_KEY=

# PostgreSQL connection string. ./scripts/purvex.sh --setup installs
# PostgreSQL and fills this in for you (prompting only for a password) --
# only set it by hand if you're pointing at an existing PostgreSQL server.
# Format: postgresql+asyncpg://purvex:password@127.0.0.1:5432/purvex
DATABASE_URL=

# --- Deployment environment ---
# Options: dev, staging, prod
PURVEX_ENV=dev

# --- Redis (required in staging/prod; enables distributed rate limiting) ---
# REDIS_URL=redis://localhost:6379/0

# --- AI Assistant (optional) ---
# AI_PROVIDER=OpenAI
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Application URL ---
# Public URL the app is reachable at. Used to build links in outbound email
# (password reset, invites). Must be set to the real URL in staging/prod.
APP_BASE_URL=http://127.0.0.1:1120

# --- Email / SMTP (optional in dev) ---
# Without this, password reset and user invites still work but no email is
# actually sent — the token/link is only visible in the server log.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@yourcompany.com
# SMTP_FROM_NAME=PurveX
# SMTP_USE_TLS=true

# --- Default admin (dev only, ignored in prod) ---
# CREATE_DEFAULT_ADMIN=true
# DEFAULT_ADMIN_EMAIL=admin
# DEFAULT_ADMIN_PASSWORD=admin
