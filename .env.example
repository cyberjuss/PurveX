# =============================================================================
# PurveX Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control.
# =============================================================================

# --- Required in ALL environments ---

# JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Encryption key for secrets at rest (SIEM credentials, TOTP secrets, API keys).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PURVEX_ENCRYPTION_KEY=

# --- Deployment environment ---
# Options: dev, staging, prod
PURVEX_ENV=dev

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://purvex:password@localhost:5432/purvex

# --- Redis (required in staging/prod; enables distributed rate limiting) ---
# REDIS_URL=redis://localhost:6379/0

# --- AI Assistant (optional) ---
# AI_PROVIDER=OpenAI
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Application URL ---
# Public URL the app is reachable at. Used to build links in outbound email
# (password reset, invites). Must be set to the real URL in staging/prod.
APP_BASE_URL=http://127.0.0.1:1120

# --- Email / SMTP (optional in dev) ---
# Without this, password reset and user invites still work but no email is
# actually sent — the token/link is only visible in the server log.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@yourcompany.com
# SMTP_FROM_NAME=PurveX
# SMTP_USE_TLS=true

# --- Default admin (dev only, ignored in prod) ---
# CREATE_DEFAULT_ADMIN=true
# DEFAULT_ADMIN_EMAIL=admin
# DEFAULT_ADMIN_PASSWORD=admin
